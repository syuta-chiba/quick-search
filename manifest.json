{
  "manifest_version": 3,
  "name": "Quick Search and Close",
  "version": "1.4",
  "description": "Select or hover any word, then press W to search Google, E to ask Gemini, Q to close the tab, or D to open Gemini popup.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}